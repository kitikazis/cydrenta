# ===========================================================
#  SSI (Server Side Includes) - CYD
#  Permite reutilizar partials/head.html y partials/scripts.html
#  con <!--#include virtual="..." --> en las paginas .html.
#  Si tu hosting NO permite SSI, el sitio dara error 500: en ese
#  caso comenta este bloque y avisa para usar otro metodo.
# ===========================================================
<IfModule mod_include.c>
  Options +Includes
  AddOutputFilter INCLUDES .html
</IfModule>

# ===========================================================
#  URLs limpias - CYD
#  /index.html      -> /           (pagina de inicio sin nombre)
#  /pagina.html     -> /pagina     (sin extension .html)
#  Internamente /pagina sirve el archivo real /pagina.html (con SSI).
# ===========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Quita "index.html" de la URL visible: /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 2) Quita ".html" del resto: /pagina.html -> /pagina
  RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 3) Sirve la pagina sin extension desde su .html real
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ===========================================================
#  Control de cache - CYD
#  Las paginas HTML nunca se cachean (siempre ven la version
#  nueva y sus referencias ?v=). Los assets se cachean fuerte
#  pero el ?v= cambia cuando los actualizas, asi que se
#  refrescan al instante. El visitante siempre ve lo ultimo.
# ===========================================================

<IfModule mod_headers.c>

  # --- HTML: nunca cachear ---
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # --- CSS / JS / imagenes / fuentes: cache largo (1 ano) ---
  # Se refrescan via ?v=<hash> cuando cambian.
  <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

</IfModule>

# Respaldo por si mod_headers no esta disponible
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 year"
</IfModule>
